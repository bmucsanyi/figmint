\figmintset{theme=normal, column=auto}
\begin{tikzpicture}
  \begin{axis}[
    figmint,
    ymode=log,
    xmin=0,
    xmax=6,
    ymin=0.01,
    ymax=1,
    xlabel={Epoch},
    ylabel={Loss},
    legend pos=south west,
  ]
    \addplot+[figmint line,domain=0:6,samples=61] {exp(-0.65*x)};
    \addlegendentry{train}
    \addplot+[figmint line marks,error bars/.cd,y dir=both,y explicit] coordinates {
      (1,0.48) +- (0,0.04)
      (2,0.22) +- (0,0.03)
      (3,0.12) +- (0,0.02)
      (4,0.08) +- (0,0.01)
      (5,0.04) +- (0,0.01)
    };
    \addlegendentry{validation}
  \end{axis}
\end{tikzpicture}
