% While PGFPlots draws the plots of an axis, the corners of a shaded surface
% (shader=interp) are canvas coordinates, but PGFPlots places the surface with
% \pgftext, which applies the current transformation a second time. In
% layered pictures, such as every figmintfigure, that transformation carries
% the offset of the axis, so every shaded surface but the first one in a
% picture lands outside its axis. The surface is therefore placed without the
% transformation during the plot phase. Legend images of surface plots are
% drawn outside that phase, in local coordinates that need the transformation.
\newcommand*{\figmint@surfacetransform}{%
    \if V\pgfplotsaxisplotphase
        \pgftransformreset
    \fi
}
\patchcmd{\pgfplotslibrarysurfdrawinpicture}{\pgftext}{\figmint@surfacetransform\pgftext}{}{%
    \figmint@patcherror\pgfplotslibrarysurfdrawinpicture
}

% Legend placement.
%
% figmint places a legend inside its axes at one of nine anchors and with the
% column count that covers the least plotted ink. docs/legend.md specifies the
% rule; src/figmint/_legend.py implements the same rule for matplotlib.
%
% Ink is collected only for an axis whose legend figmint places. Everything
% PGFPlots draws for the plots and for the TikZ commands inside such an axis
% (stroked and filled paths, nodes, and shaded surfaces) is rasterized onto
% square cells of side \c__figmint_legend_cell_dim. Collection starts after
% PGFPlots has drawn the axis background, grid, and lines below the plots, and
% it also covers the markers that PGFPlots draws after the axis. Other axes
% are not touched, so they keep the Lua backend of PGFPlots and cost nothing
% per point.
\ExplSyntaxOn

\msg_new:nnnn { figmint } { legend-mode }
  { Unknown~legend~mode~`#1'. }
  { Use~best,~fixed,~or~manual. }
\msg_new:nnnn { figmint } { legend-location }
  { Unknown~fixed~legend~location~`#1'. }
  {
    Use~north~east,~north~west,~south~west,~south~east,~east,~west,~south,~
    north,~or~center.
  }
\msg_new:nnnn { figmint } { legend-fit }
  { No~legend~placement~fits~inside~the~axes. }
  { Reduce~the~legend~size~or~place~the~legend~manually. }

\cs_generate_variant:Nn \str_case:nnF { V }
\cs_generate_variant:Nn \msg_error:nnn { nnV }

\dim_const:Nn \c__figmint_legend_cell_dim { 2pt }
\int_const:Nn \c__figmint_legend_cell_int
  { \dim_to_decimal_in_sp:n { \c__figmint_legend_cell_dim } }
\int_const:Nn \c__figmint_legend_half_cell_int { \c__figmint_legend_cell_int / 2 }
% Growth factors of the margin score are multiples of 1 / this unit.
\int_const:Nn \c__figmint_legend_scale_unit_int { 256 }
% The size score sums the legend width and height in units of 1 / this unit
% of the axes width and height.
\int_const:Nn \c__figmint_legend_size_unit_int { 10000 }

% Candidate anchors in preference order. Each item holds the preference rank,
% the PGF anchor, the position of the anchor along x and y in halves of the
% axes size, and the anchor complexity: corners and the middle of the top and
% bottom edges are simplest, the middle of the left and right edges follow,
% and the center comes last.
\seq_const_from_clist:Nn \c__figmint_legend_anchors_seq
  {
    { 1 } { north~east } { 2 } { 2 } { 0 } ,
    { 2 } { north~west } { 0 } { 2 } { 0 } ,
    { 3 } { south~west } { 0 } { 0 } { 0 } ,
    { 4 } { south~east } { 2 } { 0 } { 0 } ,
    { 5 } { east } { 2 } { 1 } { 1 } ,
    { 6 } { west } { 0 } { 1 } { 1 } ,
    { 7 } { south } { 1 } { 0 } { 0 } ,
    { 8 } { north } { 1 } { 2 } { 0 } ,
    { 9 } { center } { 1 } { 1 } { 2 } ,
  }

% Scores of a candidate, compared in this order; < marks scores where smaller
% is better and > marks scores where larger is better.
\tl_const:Nn \c__figmint_legend_scores_tl
  {
    { { badness } { < } }
    { { empty } { < } }
    { { balance } { < } }
    { { clearance } { > } }
    { { margin } { > } }
    { { complexity } { < } }
    { { size } { < } }
    { { rank } { < } }
    { { columns } { < } }
  }
\tl_map_inline:Nn \c__figmint_legend_scores_tl
  {
    \int_new:c { l__figmint_legend_candidate_ \use_i:nn #1 _int }
    \int_new:c { g__figmint_legend_best_ \use_i:nn #1 _int }
  }

