\newcommand*{\figmintlegendbeginaxis}{%
    \global\let\figmintlegendpoints\@empty
    \global\let\figmintlegendstoredentries\pgfutil@empty
    \global\figmintlegendbarcount=0
    \global\figmintlegendaxisenabledtrue
    \global\figmintlegendactivetrue
}

\newcommand*{\figmintlegendendaxis}{%
    \global\let\figmintlegendpoints\@empty
    \global\let\figmintlegendstoredentries\pgfutil@empty
    \global\figmintlegendactivefalse
    \global\figmintlegendaxisenabledfalse
    \global\figmintlegendxbarfalse
    \global\figmintlegendybarfalse
}

