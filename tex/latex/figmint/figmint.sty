                \figmintlegendcolumncount=1
                \loop
                    \ifdefstring\figmintlegendmode{fixed}{%
                        \figmintlegendtryfixedcolumns{\the\figmintlegendcolumncount}%
                    }{%
                        \figmintlegendtrycolumns{\the\figmintlegendcolumncount}%
                    }%
                    \advance\figmintlegendcolumncount by1
                    \ifnum\figmintlegendcolumncount<\numexpr\figmintlegendentrycount+1\relax
                \repeat
                \iffigmintlegendhascandidate
                    \pgfplotsset{
                        legend columns=\figmintlegendbestcolumns,
                        legend cell align=left,
                        transpose legend=false,
                        legend style={at={(\figmintlegendbestx,\figmintlegendbesty)},anchor=\figmintlegendbestanchor},
                    }%
                    \ifdefempty\figmintlegendreportname{}{%
                        \typeout{FIGMINT_LEGEND name=\figmintlegendreportname;mode=\figmintlegendmode;anchor=\figmintlegendbestanchor;columns=\figmintlegendbestcolumns;x=\figmintlegendbestx;y=\figmintlegendbesty}%
                    }%
                \else
                    \PackageError{figmint}{No grid-snapped legend placement fits inside the axes}{Reduce the legend size or place the legend explicitly.}%
                \fi
            \fi
        }{}%
        \figmintlegendendaxis
    \fi
}

