    \begingroup
    \figmintrefresh
    \figmintrequirepositiveaxisdimensions
    \begin{tikzpicture}[
        #1,
        background rectangle/.style={fill=\figmintbackgroundcolor,draw=none},
        show background rectangle,
        inner frame sep=0pt]
        \pgfplotsset{set layers=figmint}%
        \pgfplotsset{every axis/.append style={figmint figure axis}}%
}{%
    \end{tikzpicture}%
    \endgroup
}

