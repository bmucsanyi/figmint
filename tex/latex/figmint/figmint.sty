\newcommand*{\figmintrequirepositive}[2]{%
    \ifdim\fpeval{#2}pt>0pt\relax
    \else
        \PackageError{figmint}{#1 must be positive}{Use a positive value for #1.}%
    \fi
}

\newcommand*{\figmintrequirepositiveinteger}[2]{%
    \figmintrequirepositive{#1}{#2}%
    \ifdim\fpeval{abs(#2 - trunc(#2))}pt=0pt\relax
    \else
        \PackageError{figmint}{#1 must be a positive integer}{Use a positive integer for #1.}%
    \fi
}

\newcommand*{\figmintrequirepositivedimension}[2]{%
    \ifdim#2>0pt\relax
    \else
        \PackageError{figmint}{#1 must be positive}{Use a positive dimension for #1.}%
    \fi
}

\newcommand*{\figmintrequireunitinterval}[2]{%
    \ifdim\fpeval{#2}pt<0pt\relax
        \PackageError{figmint}{#1 must be between 0.0 and 1.0}{Use a unit-interval value for #1.}%
    \fi
    \ifdim\fpeval{#2}pt>1pt\relax
        \PackageError{figmint}{#1 must be between 0.0 and 1.0}{Use a unit-interval value for #1.}%
    \fi
}

\newcommand*{\figmintrequiretheme}{%
    \ifcsdef{figmint@theme@\figminttheme}{}{%
        \PackageError{figmint}{Unknown theme \figminttheme}{Use normal, latte, frappe, macchiato, or mocha.}%
    }%
}

\newcommand*{\figmintresolvebasewidth}{%
    \ifdefstring\figmintcolumn{auto}{%
        \renewcommand*{\figmintbasewidth}{\linewidth}%
    }{%
        \ifdefstring\figmintcolumn{half}{%
            \renewcommand*{\figmintbasewidth}{\columnwidth}%
        }{%
            \ifdefstring\figmintcolumn{full}{%
                \renewcommand*{\figmintbasewidth}{\textwidth}%
            }{%
                \PackageError{figmint}{Unknown column \figmintcolumn}{Use auto, half, or full.}%
            }%
        }%
    }%
}

\newcommand*{\figmintiftikzscaletrial}[2]{%
    \ifcsdef{requestedWidth}{%
        \figmintiftikzscaletrialdims{#1}{#2}%
    }{%
        \ifcsdef{requestedHeight}{%
            \figmintiftikzscaletrialdims{#1}{#2}%
        }{#2}%
    }%
}

\newcommand*{\figmintiftikzscaletrialdims}[2]{%
    \ifcsdef{tikzscale@width}{%
        \ifcsdef{tikzscale@height}{#1}{#2}%
    }{#2}%
}

\newcommand*{\figmintcomputetikzscalelayout}{%
    \pgfmathsetlengthmacro{\figmintplotwidth}{\csname tikzscale@width\endcsname pt}%
    \pgfmathsetlengthmacro{\figmintplotheight}{\csname tikzscale@height\endcsname pt}%
}

\newcommand*{\figmintcomputelayout}{%
    \ifdefempty\figmintfigurewidth{%
        \ifdefempty\figmintfigureheight{%
            \figmintiftikzscaletrial{%
                \figmintcomputetikzscalelayout
            }{%
                \figmintresolvebasewidth
                \setlength{\figmintbasewidthlength}{\figmintbasewidth}%
                \pgfmathsetlengthmacro{\figmintplotwidth}{\figmintwidthfraction*(\the\figmintbasewidthlength)}%
                \pgfmathsetlengthmacro{\figmintplotheight}{(\figmintwidthfraction/\figmintcols*\figmintheighttowidthratio*\figmintrows)*(\the\figmintbasewidthlength)}%
            }%
        }{%
            \PackageError{figmint}{figure width and figure height must be set together}{Set both dimensions or neither dimension.}%
        }%
    }{%
        \ifdefempty\figmintfigureheight{%
            \PackageError{figmint}{figure width and figure height must be set together}{Set both dimensions or neither dimension.}%
        }{%
            \setlength{\figmintfigurewidthlength}{\figmintfigurewidth}%
            \setlength{\figmintfigureheightlength}{\figmintfigureheight}%
            \figmintrequirepositivedimension{figure width}{\figmintfigurewidthlength}%
            \figmintrequirepositivedimension{figure height}{\figmintfigureheightlength}%
            \edef\figmintplotwidth{\the\figmintfigurewidthlength}%
            \edef\figmintplotheight{\the\figmintfigureheightlength}%
        }%
    }%
}

\newcommand*{\figmintcomputeaxislayout}{%
    \setlength{\figmintgrouphorizontalseplength}{\figmintgrouphorizontalsep}%
    \setlength{\figmintgroupverticalseplength}{\figmintgroupverticalsep}%
    \setlength{\figmintfigurewidthlength}{\figmintplotwidth}%
    \setlength{\figmintfigureheightlength}{\figmintplotheight}%
    \setlength{\figmintaxiswidthlength}{%
        \dimexpr(\figmintfigurewidthlength-\numexpr\figmintcols-1\relax\figmintgrouphorizontalseplength)/\figmintcols\relax}%
    \setlength{\figmintaxisheightlength}{%
        \dimexpr(\figmintfigureheightlength-\numexpr\figmintrows-1\relax\figmintgroupverticalseplength)/\figmintrows\relax}%
    \edef\figmintaxiswidth{\the\figmintaxiswidthlength}%
    \edef\figmintaxisheight{\the\figmintaxisheightlength}%
}

\newcommand*{\figmintrequirepositiveaxisdimensions}{%
    \figmintrequirepositivedimension{axis width}{\figmintaxiswidthlength}%
    \figmintrequirepositivedimension{axis height}{\figmintaxisheightlength}%
}

\newcommand*{\figmintcomputelinewidths}{%
    \edef\figmintaxislinewidth{\fpeval{\figmintlinewidth}pt}%
    \edef\figmintminorlinewidth{\fpeval{0.5 * \figmintlinewidth}pt}%
    \edef\figmintplotlinewidth{\fpeval{2.0 * \figmintlinewidth}pt}%
    \edef\figmintmajorticksize{\fpeval{max(3.0, 3.0 * \figmintlinewidth)}pt}%
    \edef\figmintminorticksize{\fpeval{max(2.0, 1.5 * \figmintlinewidth)}pt}%
}

\newcommand*{\figmintselectbackgroundcolor}{%
    \edef\figmintbackgroundcolor{\csuse{figmint@theme@\figminttheme}Background}%
    \edef\figmintcycleonecolor{\csuse{figmint@theme@\figminttheme}CycleOne}%
}

\newcommand*{\figmintrefresh}{%
    \figmintrequiretheme
    \figmintselectbackgroundcolor
    \figmintrequirepositive{width fraction}{\figmintwidthfraction}%
    \figmintrequirepositiveinteger{rows}{\figmintrows}%
    \figmintrequirepositiveinteger{cols}{\figmintcols}%
    \figmintrequirepositive{height to width ratio}{\figmintheighttowidthratio}%
    \figmintrequirepositive{line width}{\figmintlinewidth}%
    \figmintrequireunitinterval{grid alpha}{\figmintgridalpha}%
    \figmintcomputelayout
    \figmintcomputeaxislayout
    \figmintcomputelinewidths
    \pgfplotsset{figmint current theme/.style={figmint/theme \figminttheme}}%
}

\newcommand*{\figmintset}[1]{%
    \pgfqkeys{/figmint}{#1}%
    \figmintrefresh
}

\newcommand*{\figmintsettheme}[1]{%
    \edef\figminttheme{#1}%
    \figmintrefresh
}

