    }{}%
    \normalfont\figmintsecondaryfont
}

\newcommand*{\figmintlegendrecordpoint}{%
    \iffigmintlegendactive
        \ifpgfplotsaxisparsecoordinateok
            \iffigmintlegendybar
                \global\advance\figmintlegendbarcount by1
                \pgfplotscoordmath{y}{parsenumber}{0}%
                \let\figmintlegendbarbaseliney\pgfmathresult
                \xdef\figmintlegendpoints{%
                    \figmintlegendpoints
                    \noexpand\figmintlegendpoint{\the\numexpr100000+\figmintlegendbarcount\relax}{\pgfplots@current@point@x}{\figmintlegendbarbaseliney}%
                    \noexpand\figmintlegendpoint{\the\numexpr100000+\figmintlegendbarcount\relax}{\pgfplots@current@point@x}{\pgfplots@current@point@y}}%
            \else
                \iffigmintlegendxbar
                    \global\advance\figmintlegendbarcount by1
                    \pgfplotscoordmath{x}{parsenumber}{0}%
                    \let\figmintlegendbarbaselinex\pgfmathresult
                    \xdef\figmintlegendpoints{%
                        \figmintlegendpoints
                        \noexpand\figmintlegendpoint{\the\numexpr100000+\figmintlegendbarcount\relax}{\figmintlegendbarbaselinex}{\pgfplots@current@point@y}%
                        \noexpand\figmintlegendpoint{\the\numexpr100000+\figmintlegendbarcount\relax}{\pgfplots@current@point@x}{\pgfplots@current@point@y}}%
                \else
                    \xdef\figmintlegendpoints{%
                        \figmintlegendpoints
                        \noexpand\figmintlegendpoint{\the\pgfplots@numplots}{\pgfplots@current@point@x}{\pgfplots@current@point@y}}%
                \fi
            \fi
        \fi
    \fi
}

