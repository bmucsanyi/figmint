% figmint: figures drawn with matplotlib to what the document asks for.
%
% The document writes \jobname.figmint on every compile: once the engine, the
% directory of the figures, and the preamble lines a figure is drawn with, and
% for every \figmintgraphic the size of the place it stands in and the caption
% font there. The Python side of figmint draws a PDF for each figure from that
% file, and \figmintgraphic includes it.
%
% Parts of this file:
%   Colors    the named colors of the five themes
%   Themes    the theme names and the current theme
%   Keys      \figmintset, its keys, and the lengths it computes
%   File      \jobname.figmint, \figmintpreamble, and \figmintdirectory
%   Sampling  the caption font where a figure stands
%   Graphic   \figmintgraphic

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\def\figmint@version{0.2.0}
\ProvidesPackage{figmint}[2026-11-11 v\figmint@version\space Figures drawn to the document]

\RequirePackage{etoolbox}
\RequirePackage{xfp}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{iftex}

