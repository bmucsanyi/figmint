% Themes. \figminttheme names the current theme, which the file hands to the
% Python side.
\newcommand*{\figminttheme}{normal}
\csdef{figmint@theme@normal}{}
\csdef{figmint@theme@latte}{}
\csdef{figmint@theme@frappe}{}
\csdef{figmint@theme@macchiato}{}
\csdef{figmint@theme@mocha}{}
\newcommand*{\figmint@requiretheme}{%
  \ifcsdef{figmint@theme@\figminttheme}{}{%
    \PackageError{figmint}{Unknown theme \figminttheme}{Use normal, latte, frappe, macchiato, or mocha.}%
  }%
}

% Keys. \figmintset stores the keys and computes \figmintplotwidth and
% \figmintplotheight from \linewidth where it runs, so a column, a figure*, a
% subfigure, and a Beamer column all measure right.
\newcommand*{\figmintwidthfraction}{1.0}
\newcommand*{\figmintheighttowidthratio}{0.6180339887498948}
\newcommand*{\figmintrows}{1}
\newcommand*{\figmintcols}{1}
\newcommand*{\figmintfigurewidth}{}
\newcommand*{\figmintfigureheight}{}
\newcommand*{\figmintplotwidth}{\linewidth}
\newcommand*{\figmintplotheight}{0.6180339887498948\linewidth}
\newcommand*{\figmint@setfiguresize}[2]{%
  \def\figmintfigurewidth{#1}%
  \def\figmintfigureheight{#2}%
}

\DeclareKeys[figmint]{
  theme.store = \figminttheme,
  width fraction.store = \figmintwidthfraction,
  height to width ratio.store = \figmintheighttowidthratio,
  rows.store = \figmintrows,
  cols.store = \figmintcols,
  figure width.store = \figmintfigurewidth,
  figure height.store = \figmintfigureheight,
  figure size.code = \figmint@setfiguresize#1,
}

\newcommand*{\figmint@requirepositive}[2]{%
  \ifdim\fpeval{#2}pt>0pt\relax\else
    \PackageError{figmint}{#1 must be positive}{Use a positive value for #1.}%
  \fi
}
\newcommand*{\figmint@requirepositiveinteger}[2]{%
  \figmint@requirepositive{#1}{#2}%
  \ifdim\fpeval{abs(#2 - trunc(#2))}pt=0pt\relax\else
    \PackageError{figmint}{#1 must be a positive integer}{Use a positive integer for #1.}%
  \fi
}
\newcommand*{\figmint@requirepositivedimension}[2]{%
  \ifdim#2>0pt\relax\else
    \PackageError{figmint}{#1 must be positive}{Use a positive dimension for #1.}%
  \fi
}
\newcommand*{\figmint@figuresizeerror}{%
  \PackageError{figmint}{figure width and figure height must be set together}{Set both dimensions or neither dimension.}%
}

% The lengths of a figure: the stored width and height when both are set,
% else the width fraction of \linewidth, and the height of the grid of rows
% by cols panels at the height to width ratio.
\newcommand*{\figmint@computelayout}{%
  \ifdefempty\figmintfigurewidth{%
    \ifdefempty\figmintfigureheight{%
      \edef\figmintplotwidth{\fpeval{\figmintwidthfraction * \linewidth}pt}%
      \edef\figmintplotheight{\fpeval{\figmintwidthfraction / \figmintcols * \figmintheighttowidthratio * \figmintrows * \linewidth}pt}%
    }{\figmint@figuresizeerror}%
  }{%
    \ifdefempty\figmintfigureheight{\figmint@figuresizeerror}{%
      \figmint@requirepositivedimension{figure width}{\figmintfigurewidth}%
      \figmint@requirepositivedimension{figure height}{\figmintfigureheight}%
      \edef\figmintplotwidth{\the\dimexpr\figmintfigurewidth\relax}%
      \edef\figmintplotheight{\the\dimexpr\figmintfigureheight\relax}%
    }%
  }%
}
\newcommand*{\figmint@refresh}{%
  \figmint@requiretheme
  \figmint@requirepositive{width fraction}{\figmintwidthfraction}%
  \figmint@requirepositiveinteger{rows}{\figmintrows}%
  \figmint@requirepositiveinteger{cols}{\figmintcols}%
  \figmint@requirepositive{height to width ratio}{\figmintheighttowidthratio}%
  \figmint@computelayout
}
\newcommand*{\figmintset}[1]{%
  \SetKeys[figmint]{#1}%
  \figmint@refresh
}
\newcommand*{\figmintsettheme}[1]{\figmintset{theme=#1}}

% File. \jobname.figmint is written on every compile, from \begin{document}.
\newwrite\figmint@file
\newcommand*{\figmint@directory}{figures/}
\newcommand*{\figmintdirectory}[1]{\renewcommand*{\figmint@directory}{#1}}
\@onlypreamble\figmintdirectory
\newcommand*{\figmint@preamblelines}{}
% A line of the preamble the figures are drawn with. A package declares its
% line through the package/figmint/after hook, which the kernel runs at once
% when figmint is already loaded, so the load order does not matter.
\newcommand{\figmintpreamble}[1]{\gappto\figmint@preamblelines{\figmint@writepreamble{#1}}}
\@onlypreamble\figmintpreamble
\newcommand{\figmint@writepreamble}[1]{%
  \immediate\write\figmint@file{preamble=\detokenize{#1}}%
}

\AtBeginDocument{%
  \immediate\openout\figmint@file=\jobname.figmint\relax
  \immediate\write\figmint@file{figmint=\figmint@version}%
  \immediate\write\figmint@file{engine=\ifPDFTeX pdflatex\else\ifLuaTeX lualatex\else xelatex\fi\fi}%
  \immediate\write\figmint@file{directory=\figmint@directory}%
  % Fonts selected through NFSS, as under pdfTeX, are reproduced by the
  % encoding and the family defaults of the document. Under fontspec the
  % encoding is TU and the families cannot be read this way, so the package
  % that set them declares its line.
  \ifdefstring{\encodingdefault}{TU}{}{%
    \immediate\write\figmint@file{preamble=\string\usepackage[\encodingdefault]{fontenc}}%
    \immediate\write\figmint@file{preamble=\string\renewcommand{\string\rmdefault}{\rmdefault}}%
    \immediate\write\figmint@file{preamble=\string\renewcommand{\string\sfdefault}{\sfdefault}}%
    \immediate\write\figmint@file{preamble=\string\renewcommand{\string\ttdefault}{\ttdefault}}%
  }%
  \figmint@preamblelines
}

% Sampling. An empty caption is typeset through the class's own caption
% command into a box that is thrown away, with one empty formula inside so
% that the script sizes exist, and the font active there is recorded: the
% size, the two script sizes, which of the three family defaults the family
% is, the series, the shape, and the names of the text font and the four
% math families, which the Python side verifies before drawing.
\newcommand*{\figmint@sample}{%
  \setbox\z@\hbox{$ $}%
  \xdef\figmint@sampled{%
    size=\f@size;script=\sf@size;scriptscript=\ssf@size;%
    family=\ifx\f@family\sfdefault sans-serif\else\ifx\f@family\rmdefault serif\else\ifx\f@family\ttdefault monospace\else unknown\fi\fi\fi;%
    series=\f@series;shape=\f@shape;%
    fonts=\fontname\font|\fontname\textfont0|\fontname\textfont1|\fontname\textfont2|\fontname\textfont3}%
}
\newcommand*{\figmint@samplecaption}{%
  \begingroup
    \@ifclassloaded{beamer}%
      {\setbox\z@\hbox{\usebeamerfont{caption}\figmint@sample}}%
      {\setbox\z@\vbox{\hsize=\linewidth\relax\@makecaption{}{\figmint@sample}}}%
  \endgroup
}

% Graphic. \figmintgraphic<overlay>[keys of \figmintset]{name} applies the
% keys in a group, samples the caption font, writes the figure's line, and
% includes <directory><name>.pdf at its own size. A size that differs from
% the lengths by more than 0.01pt gives a warning and never an error: a
% co-author who compiles without drawing gets a document, and the owner's
% next draw redraws the figure. A figure not drawn yet leaves an empty box of
% the two lengths, so that page breaks do not move when it arrives.
\newlength{\figmint@width}
\newlength{\figmint@height}
\newif\iffigmint@sizeoff
\newcommand*{\figmint@comparesize}[2]{%
  \ifdim\dimexpr#1-#2\relax>0.01pt \figmint@sizeofftrue\fi
  \ifdim\dimexpr#2-#1\relax>0.01pt \figmint@sizeofftrue\fi
}
\newcommand*{\figmint@graphic}[2]{%
  \begingroup
    \figmintset{#1}%
    \setlength{\figmint@width}{\figmintplotwidth}%
    \setlength{\figmint@height}{\figmintplotheight}%
    \figmint@samplecaption
    \immediate\write\figmint@file{figure=#2;width=\strip@pt\figmint@width;height=\strip@pt\figmint@height;rows=\figmintrows;cols=\figmintcols;theme=\figminttheme;\figmint@sampled}%
    \IfFileExists{\figmint@directory#2.pdf}{%
      \sbox\z@{\includegraphics{\figmint@directory#2.pdf}}%
      \figmint@sizeofffalse
      \figmint@comparesize{\wd\z@}{\figmint@width}%
      \figmint@comparesize{\dimexpr\ht\z@+\dp\z@\relax}{\figmint@height}%
      \iffigmint@sizeoff
        \PackageWarning{figmint}{Figure #2 is \the\wd\z@\space by \the\dimexpr\ht\z@+\dp\z@\relax, and the document asks for \the\figmint@width\space by \the\figmint@height}%
      \fi
      \leavevmode\box\z@
    }{%
      \PackageWarning{figmint}{Figure #2 is not drawn yet}%
      \leavevmode\hbox to\figmint@width{\vrule height\figmint@height width\z@\hfil}%
    }%
  \endgroup
}
\NewDocumentCommand{\figmintgraphic}{d<> O{} m}{%
  \IfValueTF{#1}{\only<#1>{\figmint@graphic{#2}{#3}}}{\figmint@graphic{#2}{#3}}%
}
