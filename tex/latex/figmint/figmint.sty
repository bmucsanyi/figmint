% Defines theme #1, whose colors are named with prefix #2: its cycle list, its
% axis style, and the prefix that \figmintselectbackgroundcolor looks up.
\newcommand*{\figmint@definetheme}[2]{%
    \pgfplotscreateplotcyclelist{figmint #1}{%
        {color=#2CycleOne,draw=#2CycleOne},
        {color=#2CycleTwo,draw=#2CycleTwo},
        {color=#2CycleThree,draw=#2CycleThree},
        {color=#2CycleFour,draw=#2CycleFour},
        {color=#2CycleFive,draw=#2CycleFive},
        {color=#2CycleSix,draw=#2CycleSix},
        {color=#2CycleSeven,draw=#2CycleSeven},
        {color=#2CycleEight,draw=#2CycleEight},
        {color=#2CycleNine,draw=#2CycleNine},
        {color=#2CycleTen,draw=#2CycleTen}%
    }%
    \pgfplotsset{
        figmint/theme #1/.style={
            axis background/.style={fill=#2Background},
            axis line style={draw=#2Edge},
            tick style={draw=#2Edge},
            minor tick style={draw=#2Edge},
            major grid style={draw=#2Grid},
            label style={text=#2Text},
            title style={text=#2Text},
            tick label style={text=#2Text},
            every node near coord/.append style={text=#2Text},
            legend style={fill=#2Background,text=#2Text},
            cycle list name=figmint #1,
            bar cycle list/.style={cycle list name=figmint #1},
            colormap name=figmint plasma,
        },
    }%
    \csdef{figmint@theme@#1}{#2}%
}
\figmint@definetheme{normal}{FigmintNormal}
\figmint@definetheme{latte}{FigmintLatte}
\figmint@definetheme{frappe}{FigmintFrappe}
